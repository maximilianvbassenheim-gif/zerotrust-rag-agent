# ===== SHAKA — Konfiguration =====
# Kopiere diese Datei nach `.env` und trage deine Werte ein.
# `.env` ist git-ignoriert und darf NIEMALS committet werden.

# Anthropic API-Key (https://platform.claude.com) — Pflicht für Chat
ANTHROPIC_API_KEY=

# Claude-Modell (Default: claude-opus-4-8)
MODEL=claude-opus-4-8

# Denk-/Antworttiefe: low | medium | high | xhigh | max
EFFORT=high

# Zero-Trust: Wenn gesetzt, verlangt die API bei jedem Request den Header `X-API-Key`
# Empfohlen, sobald der Server nicht nur auf 127.0.0.1 lauscht.
APP_API_KEY=

# Bind-Adresse (Zero-Cloud-Default: nur localhost)
HOST=127.0.0.1
PORT=8100

# Erlaubte CORS-Origins (kommagetrennt). Leer = kein Cross-Origin-Zugriff (sicherster Modus).
ALLOWED_ORIGINS=

# Rate-Limit pro Client-IP und Minute
RATE_LIMIT_PER_MINUTE=30
